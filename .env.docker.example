POSTGRES_DB=hme_website
POSTGRES_USER=hme
POSTGRES_PASSWORD=replace-with-a-strong-local-database-password
DATABASE_URL=postgresql://hme:replace-with-a-strong-local-database-password@db:5432/hme_website
DATABASE_SSL_REJECT_UNAUTHORIZED=true
COOKIE_SECURE=false
SESSION_SECRET=replace-with-random-secret-at-least-32-characters
ADMIN_INVITE_CODE=replace-with-private-admin-invitation-code
APP_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
APP_PORT=3001
